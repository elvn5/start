{
  "permissions": {
    "allow": [
      "Bash(task:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go tool:*)",
      "Bash(go mod tidy)",
      "Bash(pnpm --filter web:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up:*)",
      "Bash(curl -s localhost:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.prod)",
      "Edit(./backend/gen/**)",
      "Edit(./backend/services/*/internal/gen/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-format.sh" }
        ]
      }
    ]
  }
}
