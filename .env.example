# Скопируйте в .env (task setup делает это автоматически).

# Порты инфраструктуры на хосте
POSTGRES_PORT=5442

# identity
IDENTITY_ADDR=:8081
IDENTITY_DATABASE_URL=postgres://app:app@localhost:5442/identity?sslmode=disable

# gateway
GATEWAY_ADDR=:8080
GATEWAY_IDENTITY_URL=http://localhost:8081

# OpenTelemetry → Grafana LGTM (http://localhost:3001)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
